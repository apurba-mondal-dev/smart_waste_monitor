# Smart Waste Monitor — Supabase Configuration
# Copy this file to .env and fill in your values from:
# Supabase Dashboard → Settings → API

# Project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Anon / Public key (safe for browser)
VITE_SUPABASE_ANON_KEY=

# Service Role key (required for admin: create/delete users)
# Keep this secret — never commit it to Git
VITE_SUPABASE_SERVICE_KEY=

